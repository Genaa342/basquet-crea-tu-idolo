                <p style="font-size:0.6rem; color:var(--accent-gold); margin-bottom:15px;">🏆 VITRINA DE TROFEOS</p>
                
                <div class="trophy-cabinet">
                    <div class="trophy-item">
                        <span class="trophy-icon">🏆</span>
                        <div class="trophy-info">
                            <strong>x1 CAMPEÓN NBA</strong>
                            <small>TEMPORADA 2026</small>
                        </div>
                    </div>

                    <div class="trophy-item">
                        <span class="trophy-icon">🥇</span>
                        <div class="trophy-info">
                            <strong>x1 MVP DE LAS FINALES</strong>
                            <small>FINALES 2026</small>
                        </div>
                    </div>

                    <div class="trophy-item">
                        <span class="trophy-icon">⭐</span>
                        <div class="trophy-info">
                            <strong>x3 ALL-STAR NBA</strong>
                            <small>2024 / 2025 / 2026</small>
                        </div>
                    </div>

                    <div class="trophy-item">
                        <span class="trophy-icon">💍</span>
                        <div class="trophy-info">
