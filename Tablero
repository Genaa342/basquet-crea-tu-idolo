<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>THE ROOKIE | Camino a la Leyenda</title>

    <!-- FUENTE 8-BIT ORIGINAL -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Anton&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --team-primary: #ffc72c;
            --team-secondary: #1d428a;
            --team-bg: #0b1120;
            --card-bg: rgba(16, 26, 48, 0.9);
            --border-pixel: #ffc72c;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
            --accent-green: #00ffcc;
            --accent-gold: #ffd700;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Press Start 2P', monospace;
            user-select: none;
        }

        body {
            background-color: var(--team-bg);
            color: var(--text-main);
            background-image: 
                linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.8)),
                radial-gradient(circle at 50% 20%, var(--team-secondary) 0%, #050811 90%);
            background-attachment: fixed;
            padding-bottom: 50px;
        }

        /* BORDES ESTILO RETRO 8-BIT */
        .pixel-box {
            background: var(--card-bg);
            border: 4px solid var(--border-pixel);
            box-shadow: 4px 4px 0px #000, inset 0 0 10px rgba(0,0,0,0.5);
            border-radius: 4px;
            padding: 15px;
            position: relative;
        }

        .pixel-btn {
            background: var(--team-primary);
            color: #000;
            border: 3px solid #000;
            padding: 8px 12px;
            font-size: 0.6rem;
            cursor: pointer;
            box-shadow: 3px 3px 0 #000;
            transition: all 0.1s;
        }

        .pixel-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 5px 5px 0 #000;
        }

        .pixel-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0 #000;
        }

        /* NAVBAR */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 4%;
            background: #000;
            border-bottom: 4px solid var(--border-pixel);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 0.9rem;
            display: flex;
            gap: 10px;
        }
        .logo span { color: #ff3366; }
        .logo strong { color: var(--accent-green); }

        .navbar nav { display: flex; gap: 20px; }
        .navbar nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.65rem;
        }
        .navbar nav a:hover { color: var(--border-pixel); }

        .user {
            font-size: 0.6rem;
            background: #111;
            padding: 6px 12px;
            border: 2px solid var(--border-pixel);
            color: var(--accent-gold);
        }

        /* CONTENEDOR PRINCIPAL DUB NATION / PLAYER CARD */
        .dashboard-grid {
            max-width: 1200px;
            margin: 20px auto;
            display: grid;
            grid-template-columns: 2.2fr 1fr;
            gap: 20px;
            padding: 0 15px;
        }

        @media (max-width: 900px) {
            .dashboard-grid { grid-template-columns: 1fr; }
        }

        /* HEADER DEL JUGADOR CON FOTO Y OVR */
        .player-header {
            display: flex;
            align-items: center;
            gap: 20px;
            background: linear-gradient(90deg, var(--team-secondary), transparent);
            padding: 15px;
            border-bottom: 3px solid var(--border-pixel);
            margin-bottom: 15px;
        }

        .ovr-badge {
            background: #fff;
            color: #000;
            font-size: 2.2rem;
            padding: 10px 15px;
            border: 4px solid #000;
            text-align: center;
            box-shadow: 4px 4px 0 var(--border-pixel);
        }
        .ovr-badge sub { font-size: 0.5rem; display: block; margin-top: 4px; }

        .player-names h2 { font-size: 1.4rem; color: #fff; text-shadow: 3px 3px 0 #000; }
        .player-names p { font-size: 0.6rem; color: var(--border-pixel); margin-top: 6px; }

        .flag { font-size: 1.2rem; }

        /* EQUIPS SELECTOR */
        .team-selector {
            margin-left: auto;
            display: flex;
            flex-direction: column;
            gap: 5px;
            align-items: flex-end;
        }

        .team-selector select {
            background: #000;
            color: #fff;
            border: 2px solid var(--border-pixel);
            font-family: 'Press Start 2P', monospace;
            font-size: 0.6rem;
            padding: 5px;
            cursor: pointer;
        }

        /* STATS DE PARTIDO (PPG, RPG, APG...) */
        .game-stats-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 20px;
        }

        .game-stat-box {
            background: rgba(0, 0, 0, 0.6);
            border: 2px solid var(--border-pixel);
            padding: 8px 4px;
            text-align: center;
        }

        .game-stat-box label { font-size: 0.45rem; color: var(--text-muted); display: block; margin-bottom: 6px; }
        .game-stat-box span { font-size: 0.9rem; color: #fff; }

        /* ATRIBUTOS Y MEJORAS */
        .attributes-section-title {
            font-size: 0.7rem;
            color: var(--border-pixel);
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
        }

        .stats-upgrade-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-item {
            background: rgba(0, 0, 0, 0.5);
            border: 2px solid #2d3748;
            padding: 10px;
        }

        .stat-item-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.55rem;
            margin-bottom: 6px;
        }

        .stat-bar-container {
            height: 12px;
            background: #111;
            border: 1px solid #444;
            margin-bottom: 8px;
            position: relative;
        }

        .stat-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--team-secondary), var(--border-pixel));
            width: 50%;
        }

        .stat-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-mini {
            background: var(--border-pixel);
            color: #000;
            border: none;
            width: 22px;
            height: 22px;
            font-size: 0.8rem;
            font-weight: bold;
            cursor: pointer;
        }

        /* ESTILO Y HABILIDADES DE JUEGO */
        .playstyle-box {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            background: rgba(0,0,0,0.6);
            padding: 10px;
            border: 2px solid var(--border-pixel);
            margin-top: 15px;
        }

        .tag-badge {
            background: var(--team-secondary);
            border: 1px solid var(--border-pixel);
            font-size: 0.45rem;
            padding: 4px;
            display: inline-block;
            margin: 2px;
            color: #fff;
        }

        /* VITRINA Y TRAYECTORIA (COLUMNA DERECHA) */
        .trophy-cabinet {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .trophy-item {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(0,0,0,0.6);
            border: 2px solid var(--border-pixel);
            padding: 8px;
        }

        .trophy-icon { font-size: 1.4rem; }
        .trophy-info strong { font-size: 0.6rem; color: var(--accent-gold); display: block; }
        .trophy-info small { font-size: 0.45rem; color: var(--text-muted); }

        .timeline-item {
            border-left: 3px solid var(--border-pixel);
            padding-left: 10px;
            margin-bottom: 12px;
            position: relative;
        }

        .timeline-item::before {
            content: '🏀';
            position: absolute;
            left: -11px;
            top: -2px;
            font-size: 0.6rem;
        }

        .timeline-item h4 { font-size: 0.55rem; color: #fff; }
        .timeline-item p { font-size: 0.45rem; color: var(--text-muted); }

        /* JUEGO CANVA INTEGRADO */
        .game-section {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 15px;
        }

        .canvas-container {
            background: #000;
            border: 4px solid var(--border-pixel);
            box-shadow: 6px 6px 0 #000;
            position: relative;
            max-width: 600px;
            margin: 0 auto;
        }

        #gameCanvas {
            width: 100%;
            display: block;
            image-rendering: pixelated;
        }

        .game-ui {
            position: absolute;
            top: 10px;
            left: 10px;
            right: 10px;
            display: flex;
            justify-content: space-between;
            pointer-events: none;
            font-size: 0.6rem;
        }

        .game-ui-box {
            background: rgba(0,0,0,0.8);
            border: 2px solid var(--border-pixel);
            padding: 6px 10px;
        }

        /* FOOTER */
        footer {
            text-align: center;
            margin-top: 40px;
            padding: 20px;
            border-top: 4px solid var(--border-pixel);
            font-size: 0.5rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo">
            <span>THE</span><strong>ROOKIE</strong>
        </div>
        <nav>
            <a href="#ficha">FICHA JUGADOR</a>
            <a href="#vitrina">VITRINA</a>
            <a href="#juego">CANCHA DE TIRO</a>
        </nav>
        <div class="user">
            👤 FRANCO23 | <span id="userXp" style="color:var(--accent-green)">XP: 100</span>
