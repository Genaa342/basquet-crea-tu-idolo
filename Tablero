    </header>

    <!-- DASHBOARD PANEL ESTILO 8-BIT DE LA IMAGEN -->
    <div class="dashboard-grid" id="ficha">
        
        <!-- PANEL IZQUIERDO: FICHA TÉCNICA Y ATRIBUTOS -->
        <div class="pixel-box">
            
            <!-- BANNER DEL JUGADOR -->
            <div class="player-header">
                <div class="ovr-badge">
                    <span id="ovrValue">90</span>
                    <sub>MEDIA</sub>
                </div>
                <div class="player-names">
