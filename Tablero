                        <strong id="valSalto">85</strong>
                    </div>
                    <div class="stat-bar-container">
                        <div class="stat-bar-fill" id="barSalto" style="width: 85%;"></div>
                    </div>
                    <div class="stat-controls">
                        <button class="btn-mini" onclick="modStat('Salto', -1)">-</button>
                        <span style="font-size:0.45rem;">NIVEL</span>
                        <button class="btn-mini" onclick="modStat('Salto', 1)">+</button>
                    </div>
                </div>

            </div>

            <!-- ESTILO Y HABILIDADES ESPECIALES -->
            <div class="playstyle-box">
                <div>
                    <p style="font-size:0.5rem; color:var(--border-pixel); margin-bottom:6px;">¿CÓMO JUEGO?</p>
                    <span class="tag-badge">BASE / ESCOLTA</span>
                    <span class="tag-badge">TIRADOR CLAVE</span>
                    <p style="font-size:0.4rem; color:var(--text-muted); margin-top:6px; line-height:1.4;">
                        Organizo, creo oportunidades de tiro y visión.
                    </p>
                </div>
                <div>
                    <p style="font-size:0.5rem; color:var(--border-pixel); margin-bottom:6px;">HABILIDADES ESPECIALES</p>
                    <span class="tag-badge">🔥 PLAYMAKER</span>
                    <span class="tag-badge">👑 LÍDER DE EQUIPO</span>
                    <span class="tag-badge">🔒 DEFENSOR PERIMETRAL</span>
                </div>
            </div>

        </div>

        <!-- PANEL DERECHO: TRAYECTORIA Y VITRINA DE TROFEOS -->
        <div style="display:flex; flex-direction:column; gap:20px;" id="vitrina">
            
            <!-- TRAYECTORIA CARRERA -->
            <div class="pixel-box">
