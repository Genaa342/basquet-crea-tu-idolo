    <!-- SECCIÓN CANCHA DE BASQUET / CANVAS DE JUEGO REAL -->
    <div class="game-section" id="juego">
        <div style="text-align:center; margin-bottom:15px;">
            <p style="font-size:0.6rem; color:var(--accent-green);">ENTRENAMIENTO</p>
            <h2 style="font-size:1.2rem; color:#fff;">CANCHA DE TIRO LIBRE</h2>
        </div>

        <div class="canvas-container">
            <div class="game-ui">
                <div class="game-ui-box">PTS: <span id="gameScore" style="color:var(--accent-gold)">0</span></div>
                <div class="game-ui-box">TIEMPO: <span id="gameTimer" style="color:#ff3366">60</span>s</div>
            </div>
            <canvas id="gameCanvas" width="500" height="400"></canvas>
        </div>
    </div>

    <footer>
        <p>THE ROOKIE | CAMINO A LA LEYENDA • PIXEL ART BASKETBALL ENGINE</p>
    </footer>

    <!-- LOGICA DEL JUEGO Y GESTIÓN DE ATRIBUTOS -->
    <script>
        // CONFIGURACIÓN DE EQUIPOS Y PALETAS DE COLOR DE LA NBA
        const teamThemes = {
            GSW: {
                primary: '#ffc72c',
                secondary: '#1d428a',
                bg: '#0b1120',
                name: 'GOLDEN STATE WARRIORS'
            },
            LAL: {
                primary: '#fdb927',
                secondary: '#552583',
                bg: '#140821',
                name: 'LOS ANGELES LAKERS'
            },
            BULLS: {
                primary: '#ce1141',
                secondary: '#000000',
                bg: '#1c030a',
                name: 'CHICAGO BULLS'
            },
            CELTICS: {
                primary: '#007a33',
                secondary: '#ba9653',
                bg: '#03170c',
                name: 'BOSTON CELTICS'
            },
            HEAT: {
                primary: '#98002e',
                secondary: '#f9a01b',
                bg: '#180209',
                name: 'MIAMI HEAT'
            }
        };

        function changeTeam(teamKey) {
            const team = teamThemes[teamKey];
            if (!team) return;

            document.documentElement.style.setProperty('--team-primary', team.primary);
            document.documentElement.style.setProperty('--team-secondary', team.secondary);
            document.documentElement.style.setProperty('--team-bg', team.bg);
            document.documentElement.style.setProperty('--border-pixel', team.primary);

            document.getElementById('teamNameText').textContent = team.name;
            document.getElementById('currentTeamTimeline').textContent = team.name;
        }

        // SISTEMA DE ATRIBUTOS
        let playerStats = {
            Tiro: 89,
            Velocidad: 86,
            Fuerza: 88,
            Control: 90,
            Defensa: 92,
            Salto: 85
        };

        let availableXp = 100;

        function updateOvr() {
            const values = Object.values(playerStats);
            const sum = values.reduce((a, b) => a + b, 0);
            const avg = Math.round(sum / values.length);
            document.getElementById('ovrValue').textContent = avg;
        }

        function modStat(statName, delta) {
            if (delta > 0 && availableXp >= 10 && playerStats[statName] < 99) {
                availableXp -= 10;
                playerStats[statName] += 1;
            } else if (delta < 0 && playerStats[statName] > 50) {
                availableXp += 10;
                playerStats[statName] -= 1;
            }

            document.getElementById('val' + statName).textContent = playerStats[statName];
            document.getElementById('bar' + statName).style.width = playerStats[statName] + '%';
            document.getElementById('availableXp').textContent = availableXp;
            document.getElementById('userXp').textContent = 'XP: ' + availableXp;
            updateOvr();
        }

        // MOTOR FÍSICO Y TIRO DE BALONCESTO EN CANVAS
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let score = 0;
        let timeLeft = 60;
        let gameActive = true;

        const ballDefault = { x: 90, y: 310, r: 12 };
        let ball = { ...ballDefault, vx: 0, vy: 0, isDragging: false, isThrown: false };
        let dragStart = { x: 0, y: 0 };
        let dragCurrent = { x: 0, y: 0 };

        const hoop = {
            x: 400,
            y: 150,
            w: 34,
            backboardX: 436,
            backboardY: 90,
            backboardH: 80
        };

        const gravity = 0.38;

        // BUCLE TEMPORIZADOR
        const timer = setInterval(() => {
            if (timeLeft > 0) {
                timeLeft--;
                document.getElementById('gameTimer').textContent = timeLeft;
            } else {
                gameActive = false;
                clearInterval(timer);
            }
        }, 1000);

        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: (clientX - rect.left) * (canvas.width / rect.width),
                y: (clientY - rect.top) * (canvas.height / rect.height)
            };
        }

        function startDrag(e) {
            if (ball.isThrown || !gameActive) return;
            const p = getPos(e);
            if (Math.hypot(p.x - ball.x, p.y - ball.y) < ball.r * 3) {
                ball.isDragging = true;
                dragStart = { x: ball.x, y: ball.y };
                dragCurrent = p;
            }
        }

        function moveDrag(e) {
            if (ball.isDragging) dragCurrent = getPos(e);
        }

        function endDrag() {
            if (!ball.isDragging) return;
            ball.isDragging = false;
            ball.isThrown = true;

            const dx = dragStart.x - dragCurrent.x;
            const dy = dragStart.y - dragCurrent.y;

            // POTENCIA MEJORADA
            const powerFactor = 0.22 + (playerStats.Tiro / 350);
            const arcFactor = 0.22 + (playerStats.Salto / 400);

            ball.vx = dx * powerFactor;
            ball.vy = dy * arcFactor;
        }

        canvas.addEventListener('mousedown', startDrag);
        canvas.addEventListener('mousemove', moveDrag);
        window.addEventListener('mouseup', endDrag);

        canvas.addEventListener('touchstart', startDrag);
        canvas.addEventListener('touchmove', moveDrag);
        window.addEventListener('touchend', endDrag);

        function resetBall() {
            ball.x = ballDefault.x + (Math.random() * 30 - 15);
            ball.y = ballDefault.y;
            ball.vx = 0;
            ball.vy = 0;
            ball.isThrown = false;
            ball.isDragging = false;
        }

        function update() {
            if (ball.isThrown) {
                ball.x += ball.vx;
                ball.y += ball.vy;
                ball.vy += gravity;

                // REBOTE TABLERO
                if (ball.x + ball.r >= hoop.backboardX && ball.y >= hoop.backboardY && ball.y <= hoop.backboardY + hoop.backboardH) {
                    ball.vx = -ball.vx * 0.6;
                    ball.x = hoop.backboardX - ball.r;
                }

                // DETECCIÓN DE ANOTACIÓN
                const hoopCenterX = hoop.x + hoop.w / 2;
                if (Math.abs(ball.x - hoopCenterX) < hoop.w / 2 && Math.abs(ball.y - hoop.y) < 10 && ball.vy > 0) {
                    score += 2;
                    availableXp += 10;
                    document.getElementById('gameScore').textContent = score;
                    document.getElementById('availableXp').textContent = availableXp;
                    document.getElementById('userXp').textContent = 'XP: ' + availableXp;
                    resetBall();
                }

                if (ball.y > canvas.height + 20 || ball.x > canvas.width + 20 || ball.x < -20) {
                    resetBall();
                }
            }
        }

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Fondo Cancha
            ctx.fillStyle = '#111827';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Suelo de Madera
            ctx.fillStyle = '#92400e';
            ctx.fillRect(0, 340, canvas.width, 60);

            // Tablero y Aro
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(hoop.backboardX, hoop.backboardY, 8, hoop.backboardH);
            ctx.fillStyle = '#ef4444';
            ctx.fillRect(hoop.x, hoop.y, hoop.w, 5);

            // Parábola de Guía
            if (ball.isDragging) {
                const dx = dragStart.x - dragCurrent.x;
                const dy = dragStart.y - dragCurrent.y;
                const powerFactor = 0.22 + (playerStats.Tiro / 350);
                const arcFactor = 0.22 + (playerStats.Salto / 400);

                let simX = ball.x;
                let simY = ball.y;
                let simVx = dx * powerFactor;
                let simVy = dy * arcFactor;

                ctx.fillStyle = '#00ffcc';
                for (let i = 0; i < 30; i++) {
                    simX += simVx;
                    simY += simVy;
                    simVy += gravity;
                    ctx.fillRect(simX, simY, 3, 3);
                }
            }

            // Pelota
            ctx.fillStyle = '#f97316';
            ctx.beginPath();
            ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#000';
            ctx.lineWidth = 2;
            ctx.stroke();

            if (!gameActive) {
                ctx.fillStyle = 'rgba(0,0,0,0.85)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#00ffcc';
                ctx.font = '12px "Press Start 2P"';
                ctx.textAlign = 'center';
                ctx.fillText("¡ENTRENAMIENTO FINALIZADO!", canvas.width / 2, 180);
                ctx.fillText("PUNTOS TOTALES: " + score, canvas.width / 2, 220);
            }
        }

        function gameLoop() {
            update();
            render();
            requestAnimationFrame(gameLoop);
        }

        gameLoop();
    </script>

</body>
</html>
