            <!-- MEJORA DE ATRIBUTOS EN TIEMPO REAL -->
            <div class="attributes-section-title">
                <span>★ ATRIBUTOS DE JUEGO</span>
                <span>PUNTOS XP: <strong id="availableXp" style="color:var(--accent-green)">100</strong></span>
            </div>

            <div class="stats-upgrade-grid">
                
                <!-- TIRO -->
                <div class="stat-item">
                    <div class="stat-item-header">
                        <span>🎯 TIRO (POTENCIA)</span>
                        <strong id="valTiro">89</strong>
                    </div>
                    <div class="stat-bar-container">
                        <div class="stat-bar-fill" id="barTiro" style="width: 89%;"></div>
                    </div>
                    <div class="stat-controls">
                        <button class="btn-mini" onclick="modStat('Tiro', -1)">-</button>
                        <span style="font-size:0.45rem;">NIVEL</span>
                        <button class="btn-mini" onclick="modStat('Tiro', 1)">+</button>
                    </div>
                </div>

                <!-- VELOCIDAD -->
                <div class="stat-item">
                    <div class="stat-item-header">
                        <span>⚡ VELOCIDAD</span>
                        <strong id="valVelocidad">86</strong>
                    </div>
                    <div class="stat-bar-container">
                        <div class="stat-bar-fill" id="barVelocidad" style="width: 86%;"></div>
                    </div>
                    <div class="stat-controls">
                        <button class="btn-mini" onclick="modStat('Velocidad', -1)">-</button>
                        <span style="font-size:0.45rem;">NIVEL</span>
                        <button class="btn-mini" onclick="modStat('Velocidad', 1)">+</button>
                    </div>
                </div>

                <!-- FUERZA -->
                <div class="stat-item">
                    <div class="stat-item-header">
                        <span>🏋️ FUERZA</span>
                        <strong id="valFuerza">88</strong>
                    </div>
                    <div class="stat-bar-container">
                        <div class="stat-bar-fill" id="barFuerza" style="width: 88%;"></div>
                    </div>
                    <div class="stat-controls">
                        <button class="btn-mini" onclick="modStat('Fuerza', -1)">-</button>
                        <span style="font-size:0.45rem;">NIVEL</span>
                        <button class="btn-mini" onclick="modStat('Fuerza', 1)">+</button>
                    </div>
                </div>

                <!-- CONTROL / MANEJO -->
                <div class="stat-item">
                    <div class="stat-item-header">
                        <span>🏀 CONTROL</span>
                        <strong id="valControl">90</strong>
                    </div>
                    <div class="stat-bar-container">
                        <div class="stat-bar-fill" id="barControl" style="width: 90%;"></div>
                    </div>
                    <div class="stat-controls">
                        <button class="btn-mini" onclick="modStat('Control', -1)">-</button>
                        <span style="font-size:0.45rem;">NIVEL</span>
                        <button class="btn-mini" onclick="modStat('Control', 1)">+</button>
                    </div>
                </div>

                <!-- DEFENSA -->
                <div class="stat-item">
                    <div class="stat-item-header">
                        <span>🛡️ DEFENSA</span>
                        <strong id="valDefensa">92</strong>
                    </div>
                    <div class="stat-bar-container">
                        <div class="stat-bar-fill" id="barDefensa" style="width: 92%;"></div>
                    </div>
                    <div class="stat-controls">
