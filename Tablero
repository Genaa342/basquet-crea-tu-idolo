            </div>

            <!-- PROMEDIOS POR PARTIDO -->
            <div class="game-stats-row">
                <div class="game-stat-box">
                    <label>PTS / PARTIDO</label>
                    <span style="color: var(--accent-gold)">28.7</span>
                </div>
                <div class="game-stat-box">
                    <label>REBOTES</label>
                    <span>10.4</span>
                </div>
                <div class="game-stat-box">
                    <label>ASISTENCIAS</label>
                    <span>8.9</span>
                </div>
                <div class="game-stat-box">
                    <label>ROBOS</label>
                    <span>2.3</span>
                </div>
                <div class="game-stat-box">
                    <label>TAPONES</label>
                    <span>1.5</span>
                </div>
